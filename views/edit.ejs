<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit-Route</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
     
    <h1>Edit-Your Message</h1>

     <h2>UserId:-<%=chat._id %> </h2>
    <h2>Sender:-<%= chat.from %></h2>
      <h2>Receiver:-<%= chat.to %></h2>

    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
      <p>Edit Your-Message</p>
    <textarea name="editmsg" placeholder="Edit Your-Message"><%= chat.msg %></textarea>
    <br><br>
    <button>Submit</button>
     </form>

    

</body>
</html>